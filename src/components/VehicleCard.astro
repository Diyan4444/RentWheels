---
import type { Vehicle } from '../data/vehicles';
import { formatINR } from '../scripts/pricing';

interface Props {
  vehicle: Vehicle;
}

const { vehicle } = Astro.props;
const mainImage = vehicle.images[0];
---

<article class="vehicle-card" data-slug={vehicle.slug} data-category={vehicle.category}>
  <div class="card-image-wrapper">
    <a href={`/vehicles/${vehicle.slug}`} class="image-link" tabindex="-1" aria-hidden="true">
      <img
        src={`/${mainImage.file}`}
        alt={mainImage.alt}
        width="400"
        height="267"
        loading="lazy"
        decoding="async"
        class="card-image"
      />
    </a>
    <span class="category-badge caption-4">{vehicle.category}</span>
  </div>

  <div class="card-content">
    <div class="card-header">
      <h3 class="title-2 vehicle-title">
        <a href={`/vehicles/${vehicle.slug}`} class="title-link">{vehicle.name}</a>
      </h3>
    </div>

    <p class="caption-2 specs-line">
      <span>{vehicle.seats} Seats</span>
      <span class="bullet" aria-hidden="true">&bull;</span>
      <span>{vehicle.specs.fuelType}</span>
      {vehicle.efficiency && (
        <>
          <span class="bullet" aria-hidden="true">&bull;</span>
          <span>{vehicle.efficiency.value} {vehicle.efficiency.unit}</span>
        </>
      )}
      {vehicle.evSpecs && (
        <>
          <span class="bullet" aria-hidden="true">&bull;</span>
          <span>{vehicle.evSpecs.claimedRange}</span>
        </>
      )}
    </p>

    <div class="card-footer">
      <div class="price-container">
        <span class="price-amount title-2">{formatINR(vehicle.estimatedRatePer24h)}</span>
        <span class="price-period caption-3">per 24 hours</span>
      </div>

      <div class="card-actions">
        <button
          type="button"
          class="btn-add-trip button-sm"
          data-slug={vehicle.slug}
          aria-label={`Add ${vehicle.name} to trip`}
        >
          Add to trip
        </button>
      </div>
    </div>
  </div>
</article>

<style>
  .vehicle-card {
    background: var(--surface-glass-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-16);
    padding: 10px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 24px rgba(4, 21, 34, 0.45);
    transition: all var(--duration-color) var(--ease-base);
  }

  .vehicle-card:hover {
    border-color: rgba(18, 184, 208, 0.35);
    box-shadow: 0 12px 32px rgba(4, 21, 34, 0.65), 0 0 24px rgba(18, 184, 208, 0.12);
    transform: translateY(-2px);
  }

  .card-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-12);
    overflow: hidden;
    background: radial-gradient(circle at center, rgba(7, 83, 106, 0.3) 0%, rgba(7, 21, 34, 0.9) 100%);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-layout) var(--ease-base);
  }

  .vehicle-card:hover .card-image {
    transform: scale(1.04);
  }

  .category-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(4, 25, 39, 0.82);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(120, 210, 230, 0.25);
    color: var(--color-cyan-bright);
    text-transform: uppercase;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border-radius: var(--radius-full);
  }

  .card-content {
    padding: var(--space-150, 12px) var(--space-100) var(--space-75);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--space-75);
  }

  .card-header {
    display: flex;
    flex-direction: column;
  }

  .vehicle-title {
    color: var(--text-primary);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .title-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-color) var(--ease-base);
  }

  .title-link:hover {
    color: var(--color-cyan-bright);
  }

  .specs-line {
    color: var(--text-tertiary);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    margin: 0;
  }

  .bullet {
    color: rgba(120, 210, 230, 0.35);
  }

  .card-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: auto;
    padding-top: var(--space-150, 12px);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    gap: var(--space-100);
  }

  .price-container {
    display: flex;
    flex-direction: column;
  }

  .price-amount {
    color: var(--text-primary);
    font-weight: 700;
    font-size: 18px;
  }

  .price-period {
    color: var(--text-tertiary);
    font-size: 12px;
  }

  .btn-add-trip {
    background: rgba(16, 42, 61, 0.8);
    border: 1px solid var(--border-glass);
    color: var(--text-primary);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    min-height: 38px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all var(--duration-color) var(--ease-base);
  }

  .btn-add-trip:hover {
    background: rgba(7, 83, 106, 0.6);
    border-color: var(--color-cyan-bright);
    color: #ffffff;
    box-shadow: 0 0 14px rgba(18, 184, 208, 0.25);
  }

  .btn-add-trip.is-added {
    background: var(--action-primary);
    color: #ffffff;
    border-color: var(--action-primary);
    box-shadow: var(--glow-blue-cta);
  }
</style>

<script>
  import { addToTrip, isInTrip, showToast } from '../scripts/trip';

  function initCards() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.btn-add-trip');
    buttons.forEach((btn) => {
      const slug = btn.getAttribute('data-slug');
      if (!slug) return;

      if (isInTrip(slug)) {
        btn.textContent = 'In your trip';
        btn.classList.add('is-added');
      } else {
        btn.textContent = 'Add to trip';
        btn.classList.remove('is-added');
      }

      // Avoid attaching multiple event listeners
      if (btn.getAttribute('data-listener-attached') === 'true') return;
      btn.setAttribute('data-listener-attached', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const currentSlug = btn.getAttribute('data-slug');
        if (!currentSlug) return;
        const res = addToTrip(currentSlug);
        showToast(res.message);
        if (res.success) {
          btn.textContent = 'In your trip';
          btn.classList.add('is-added');
        }
      });
    });
  }

  window.addEventListener('DOMContentLoaded', initCards);
  window.addEventListener('rentwheels:trip-updated', initCards);
</script>
