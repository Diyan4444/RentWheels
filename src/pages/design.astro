---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Design Tokens & Component Reference | RentWheels" noindex={true}>
  <div class="container design-container">
    <h1 class="heading-2">Design Tokens & Component Reference</h1>
    <p class="body-3 intro-lead">
      Visual regression baseline and verification for design system tokens (Section 5.12).
    </p>

    <!-- 1. Color Palettes -->
    <section class="design-section">
      <h2 class="title-1">1. Semantic Surfaces & Text (Layer 2)</h2>
      <div class="swatches-grid">
        <div class="swatch-card" style="background-color: var(--surface-primary);">
          <span class="caption-2">Surface/Primary (#181818)</span>
        </div>
        <div class="swatch-card" style="background-color: var(--surface-primary-subtle);">
          <span class="caption-2">Surface/Primary-Subtle (#1F1F1F)</span>
        </div>
        <div class="swatch-card" style="background-color: var(--surface-secondary);">
          <span class="caption-2">Surface/Secondary (#272727)</span>
        </div>
        <div class="swatch-card" style="background-color: var(--surface-secondary-subtle);">
          <span class="caption-2">Surface/Secondary-Subtle (#313131)</span>
        </div>
        <div class="swatch-card" style="background-color: var(--action-primary); color: var(--text-inverted);">
          <span class="caption-2">Action/Primary (#D9822B)</span>
        </div>
      </div>
    </section>

    <!-- 2. Typography Hierarchy -->
    <section class="design-section">
      <h2 class="title-1">2. Typography Hierarchy</h2>
      <div class="type-samples-list">
        <div><span class="caption-3">Heading 1:</span> <h1 class="heading-1">From a scooter to a bus</h1></div>
        <div><span class="caption-3">Heading 2:</span> <h2 class="heading-2">Featured vehicles</h2></div>
        <div><span class="caption-3">Heading 3:</span> <h3 class="heading-3">Honda Civic</h3></div>
        <div><span class="caption-3">Title 1:</span> <div class="title-1">₹3,100 per 24 hours</div></div>
        <div><span class="caption-3">Body 3:</span> <p class="body-3">Pick your dates once and every vehicle shows its price for the whole trip.</p></div>
        <div><span class="caption-3">Caption 1:</span> <span class="caption-1">15 vehicles across 5 types in Mumbai</span></div>
      </div>
    </section>

    <!-- 3. Button Components & States -->
    <section class="design-section">
      <h2 class="title-1">3. Buttons & Interactive States</h2>
      <div class="buttons-row">
        <button type="button" class="btn-demo-primary button-md">Primary Button</button>
        <button type="button" class="btn-demo-secondary button-md">Secondary Button</button>
        <button type="button" class="btn-demo-primary button-md" disabled>Disabled Button</button>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .design-container {
    padding-top: var(--space-600);
    padding-bottom: var(--space-900);
  }

  .intro-lead {
    color: var(--text-secondary);
    margin-top: var(--space-75);
    margin-bottom: var(--space-600);
  }

  .design-section {
    margin-bottom: var(--space-600);
    padding-bottom: var(--space-600);
    border-bottom: 1px solid var(--border-primary);
  }

  .design-section h2 {
    color: var(--text-primary);
    margin-bottom: var(--space-300);
  }

  .swatches-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-200);
  }

  .swatch-card {
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-8);
    height: 100px;
    padding: var(--space-100);
    display: flex;
    align-items: flex-end;
    color: var(--text-primary);
  }

  .type-samples-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-300);
  }

  .type-samples-list span {
    color: var(--text-tertiary);
  }

  .buttons-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-200);
  }

  .btn-demo-primary {
    background-color: var(--action-primary);
    color: var(--text-inverted);
    padding: var(--space-100) var(--space-300);
    border-radius: var(--radius-8);
    font-weight: 600;
  }

  .btn-demo-secondary {
    background-color: var(--surface-secondary);
    border: 1px solid var(--border-control);
    color: var(--text-primary);
    padding: var(--space-100) var(--space-300);
    border-radius: var(--radius-8);
    font-weight: 600;
  }
</style>
