---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | RentWheels"
  description="The requested page could not be found on RentWheels."
  noindex={true}
>
  <div class="container notfound-container">
    <div class="notfound-box">
      <h1 class="heading-1 status-code">404</h1>
      <h2 class="title-1">Page Not Found</h2>
      <p class="body-3 notfound-desc">
        We could not find the page you were looking for. It may have been moved as part of our platform redesign.
      </p>
      <div class="notfound-actions">
        <a href="/" class="btn-primary button-md">Return Home</a>
        <a href="/fleet" class="btn-secondary button-md">Browse Fleet</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound-container {
    padding-top: var(--space-800);
    padding-bottom: var(--space-900);
    display: flex;
    justify-content: center;
  }

  .notfound-box {
    max-width: 500px;
    text-align: center;
    background-color: var(--surface-primary-subtle);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-16);
    padding: var(--space-600) var(--space-400);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-200);
  }

  .status-code {
    color: var(--action-primary);
  }

  .notfound-desc {
    color: var(--text-secondary);
  }

  .notfound-actions {
    display: flex;
    gap: var(--space-200);
    margin-top: var(--space-200);
  }

  .btn-primary {
    background-color: var(--action-primary);
    color: var(--text-inverted);
    padding: var(--space-100) var(--space-300);
    border-radius: var(--radius-8);
    font-weight: 600;
  }

  .btn-secondary {
    background-color: var(--surface-secondary);
    border: 1px solid var(--border-control);
    color: var(--text-primary);
    padding: var(--space-100) var(--space-300);
    border-radius: var(--radius-8);
    font-weight: 600;
  }
</style>
