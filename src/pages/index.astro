---
import BaseLayout from '../layouts/BaseLayout.astro';
import VehicleCard from '../components/VehicleCard.astro';
import { vehicles } from '../data/vehicles';
import { formatINR } from '../scripts/pricing';

const featuredVehicles = vehicles.filter((v) => v.featured);
const flagshipVehicle = vehicles.find((v) => v.slug === 'ford-mustang-gt') || vehicles[0];

const categories = [
  { index: '01', name: 'Cars', slug: 'cars', count: 3, startingRate: 3100, desc: 'Sedans, crossovers, and performance coupes' },
  { index: '02', name: 'Motorcycles', slug: 'bikes', count: 3, startingRate: 1300, desc: 'Cruisers, adventure tourers, and performance singles' },
  { index: '03', name: 'Scooters', slug: 'scooters', count: 3, startingRate: 1300, desc: 'Classic and modern city commuters' },
  { index: '04', name: 'Coaches & Buses', slug: 'buses', count: 3, startingRate: 16400, desc: 'Executive coaches and passenger transport' },
  { index: '05', name: 'Commercial & Trucks', slug: 'trucks', count: 3, startingRate: 8700, desc: 'Heavy haulers and dual-motor electric pickups' },
];

const mumbaiHubs = [
  { value: 'mumbai-central', label: 'Mumbai Central (Railway Hub)' },
  { value: 'bandra-west', label: 'Bandra West (Linking Road / Station)' },
  { value: 'andheri-east', label: 'Andheri East (WEH Metro Hub)' },
  { value: 'bkc', label: 'Bandra Kurla Complex (BKC Financial District)' },
  { value: 'borivali-west', label: 'Borivali West (Link Road)' },
  { value: 'airport-t2', label: 'CSMI Airport T2 (International / Domestic)' },
];
---

<BaseLayout
  title="RentWheels — Vehicle Rentals Across Mumbai | Cars, Bikes, Scooters, Buses, Trucks"
  description="Discover a curated vehicle fleet across Mumbai with transparent 24-hour pricing. Rent cars, motorcycles, scooters, coaches and trucks with one consolidated booking enquiry."
>
  <!-- ========================================================================
       TAB 1: Hero Section & Journey Planning Panel with Header_bg
       ======================================================================== -->
  <div class="hero-tab1-wrapper">
    <!-- 1. Cinematic Hero Section — Asymmetric Editorial Canvas -->
    <section class="hero-canvas" aria-label="Introduction">
      <!-- Atmospheric Ambient Lighting -->
      <div class="hero-ambient-spot" aria-hidden="true"></div>

      <div class="container hero-container">
        <div class="hero-layout">
          <!-- Hero Editorial Column -->
          <div class="hero-editorial">
            <h1 class="hero-headline">
              <span class="hero-headline-line">More than a ride.</span>
              <span class="hero-headline-line accent-line">A journey worth taking.</span>
            </h1>

            <p class="hero-narrative">
              From everyday city drives to memorable road trips, discover a vehicle that makes every journey feel different.
            </p>

            <div class="hero-action-row">
              <a href="/fleet" class="hero-primary-action">
                <span>Explore the fleet</span>
                <svg class="action-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
              <a href="#categories" class="hero-secondary-link">
                <span>Browse classes &darr;</span>
              </a>
            </div>
          </div>

          <!-- Integrated Brand Logo Visual -->
          <div class="hero-visual-stage">
            <img
              src="/RentWheels Speed Brand Logo.png"
              alt="RentWheels Speed Brand Logo"
              width="800"
              height="400"
              loading="eager"
              fetchpriority="high"
              class="hero-brand-logo-img"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Streamlined Journey Planning Panel (Booking Interface) -->
    <section class="planner-section" aria-label="Journey Search">
      <div class="container planner-container">
        <form id="heroSearchForm" class="planner-bar" action="/fleet" method="GET">
          <!-- Segment 1: Location -->
          <div class="planner-segment">
            <label for="pickupLocation" class="segment-label">
              <svg class="field-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>Pickup Hub</span>
            </label>
            <select id="pickupLocation" name="location" class="segment-select">
              {mumbaiHubs.map((hub) => (
                <option value={hub.value}>{hub.label}</option>
              ))}
            </select>
          </div>

          <div class="planner-divider" aria-hidden="true"></div>

          <!-- Segment 2: Pickup Schedule -->
          <div class="planner-segment">
            <span class="segment-label">
              <svg class="field-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>Pickup Schedule</span>
            </span>
            <div class="datetime-cluster">
              <input type="date" id="pickupDate" name="from" class="segment-input-date" required aria-label="Pickup date" />
              <input type="time" id="pickupTime" name="pickupTime" value="10:00" class="segment-input-time" required aria-label="Pickup time" />
            </div>
          </div>

          <div class="planner-divider" aria-hidden="true"></div>

          <!-- Segment 3: Return Schedule -->
          <div class="planner-segment">
            <span class="segment-label">
              <svg class="field-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>Return Schedule</span>
            </span>
            <div class="datetime-cluster">
              <input type="date" id="returnDate" name="to" class="segment-input-date" required aria-label="Return date" />
              <input type="time" id="returnTime" name="returnTime" value="10:00" class="segment-input-time" required aria-label="Return time" />
            </div>
          </div>

          <!-- Segment 4: Search Action -->
          <div class="planner-action-segment">
            <button type="submit" class="planner-submit-btn" aria-label="Search available fleet">
              <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <span>Find vehicles</span>
            </button>
          </div>
        </form>

        <!-- Restrained Secondary Duration Context -->
        <div id="heroDurationIndicator" class="planner-duration-hint" aria-live="polite"></div>
      </div>
    </section>
  </div>

  <!-- ========================================================================
       3. The Fleet by Category — Editorial Showcase
       ======================================================================== -->
  <section id="categories" class="editorial-section">
    <div class="container">
      <div class="category-editorial-grid">
        <!-- Left Column: Editorial Statement -->
        <div class="category-editorial-copy">
          <span class="editorial-eyebrow">The Fleet</span>
          <h2 class="editorial-title">Five categories of movement.</h2>
          <p class="editorial-lead">
            From nimble two-wheelers threading through Mumbai traffic to executive passenger coaches and heavy haulers, every vehicle adheres to standard 24-hour rental terms.
          </p>
        </div>

        <!-- Right Column: Editorial Category Index -->
        <div class="category-index-list">
          {categories.map((cat) => (
            <a href={`/fleet/${cat.slug}`} class="category-index-row">
              <span class="index-num">{cat.index}</span>
              <div class="index-body">
                <div class="index-title-group">
                  <span class="index-name">{cat.name}</span>
                  <span class="index-count">{cat.count} vehicles</span>
                </div>
                <span class="index-desc">{cat.desc}</span>
              </div>
              <div class="index-action">
                <span class="index-rate">From {formatINR(cat.startingRate)} / 24h</span>
                <span class="index-arrow" aria-hidden="true">&rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       4. Featured Vehicles — Refined Automotive Showcase
       ======================================================================== -->
  <section class="editorial-section">
    <div class="container">
      <div class="section-title-row">
        <div>
          <span class="editorial-eyebrow">Curated Selection</span>
          <h2 class="editorial-title">Featured across the fleet</h2>
        </div>
        <a href="/fleet" class="editorial-text-link">
          <span>Complete fleet directory</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="featured-grid">
        {featuredVehicles.map((v) => (
          <VehicleCard vehicle={v} />
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================
       5. The Editorial Advantage — Unified Enquiry Philosophy
       ======================================================================== -->
  <section class="editorial-section">
    <div class="container">
      <div class="philosophy-stage">
        <div class="philosophy-content">
          <span class="editorial-eyebrow">The RentWheels Philosophy</span>
          <h2 class="philosophy-title">
            One consolidated enquiry. No fragmented bookings.
          </h2>
          <p class="philosophy-narrative">
            A family vacation, a corporate event, or a commercial project often calls for very different vehicles. Traditional rental agencies force you to juggle separate vendors, conflicting security deposits, and inconsistent calendar-day rules. RentWheels brings all five categories under a single booking request with transparent 24-hour billing and verified specifications.
          </p>
          <div class="philosophy-points">
            <div class="point-item">
              <span class="point-title">Unified Enquiry</span>
              <span class="point-desc">Combine cars, bikes, and buses in one consolidated submission.</span>
            </div>
            <div class="point-item">
              <span class="point-title">24-Hour Periods</span>
              <span class="point-desc">Strictly calculated from your pickup time with ceiling rounding.</span>
            </div>
            <div class="point-item">
              <span class="point-title">Verified Specifications</span>
              <span class="point-desc">Every vehicle backed by primary manufacturer documentation.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       6. How Enquiries Work
       ======================================================================== -->
  <section id="how-it-works" class="editorial-section">
    <div class="container">
      <div class="section-title-row">
        <div>
          <span class="editorial-eyebrow">The Process</span>
          <h2 class="editorial-title">How booking enquiries work</h2>
        </div>
      </div>

      <div class="process-sequence">
        <div class="process-step">
          <span class="process-step-num">01</span>
          <h3 class="process-step-title">Select schedule and vehicle</h3>
          <p class="process-step-desc">
            Choose your pickup and return dates in Mumbai. Indicative rates dynamically calculate for your consecutive 24-hour rental periods.
          </p>
        </div>

        <div class="process-step">
          <span class="process-step-num">02</span>
          <h3 class="process-step-title">Stage your journey</h3>
          <p class="process-step-desc">
            Add multiple vehicles across any categories to your trip staging. Review combined requirements before submitting.
          </p>
        </div>

        <div class="process-step">
          <span class="process-step-num">03</span>
          <h3 class="process-step-title">Submit enquiry</h3>
          <p class="process-step-desc">
            Send your request via Netlify Forms without online payments. Our Mumbai team confirms vehicle availability and final details.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       7. Frequently Asked Questions
       ======================================================================== -->
  <section class="editorial-section">
    <div class="container faq-narrow-container">
      <div class="section-title-row">
        <div>
          <span class="editorial-eyebrow">Information</span>
          <h2 class="editorial-title">Frequently asked questions</h2>
        </div>
      </div>

      <div class="faq-accordion-list">
        <details class="faq-item">
          <summary class="faq-summary">
            <span>How does a booking request work?</span>
            <svg class="faq-toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </summary>
          <div class="faq-drawer">
            Choose your dates and vehicles, stage them in your trip, and submit the enquiry form. RentWheels receives your request through Netlify Forms and contacts you to confirm availability and final terms. No online payments are taken on this website.
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-summary">
            <span>How are the 24-hour rental periods billed?</span>
            <svg class="faq-toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </summary>
          <div class="faq-drawer">
            Rental duration is calculated strictly on consecutive 24-hour cycles starting from your selected pickup time (Asia/Kolkata timezone). Any additional commenced period is rounded up to the next full 24-hour period (ceiling rule). Calendar-day billing is not used.
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-summary">
            <span>Can I rent more than one vehicle in a single request?</span>
            <svg class="faq-toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </summary>
          <div class="faq-drawer">
            Yes. You can add up to 5 vehicles across any categories (such as two cars and a passenger bus) to your trip and submit a single consolidated enquiry.
          </div>
        </details>
      </div>

      <div class="faq-footer-action">
        <a href="/faq" class="editorial-text-link">
          <span>Explore all inquiries &rarr;</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==========================================================================
     Tab 1: Hero Canvas & Journey Planning Panel with Header_bg.jpg
     ========================================================================== */
  .hero-tab1-wrapper {
    position: relative;
    background: linear-gradient(180deg, rgba(7, 21, 34, 0.45) 0%, rgba(7, 21, 34, 0.6) 55%, rgba(7, 21, 34, 0.92) 100%),
                url('/Header_bg.jpg') center center / cover no-repeat;
    border-bottom: 1px solid rgba(120, 210, 230, 0.16);
  }

  .hero-canvas {
    position: relative;
    padding: var(--space-700) 0 var(--space-300);
    overflow: hidden;
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-canvas {
      min-height: 72vh;
      padding: var(--space-800) 0 var(--space-400);
    }
  }

  .hero-ambient-spot {
    position: absolute;
    top: 20%;
    right: 15%;
    width: 600px;
    height: 450px;
    background: radial-gradient(ellipse at center, rgba(7, 83, 106, 0.25) 0%, rgba(6, 59, 80, 0.1) 50%, transparent 75%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-600);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-layout {
      grid-template-columns: 1fr 1.15fr;
      gap: var(--space-700);
    }
  }

  /* Editorial Copy */
  .hero-editorial {
    display: flex;
    flex-direction: column;
    gap: var(--space-300);
    max-width: 540px;
  }

  .hero-headline {
    display: flex;
    flex-direction: column;
    font-family: var(--font-sans);
    font-size: 38px;
    line-height: 1.12;
    letter-spacing: -0.035em;
    margin: 0;
  }

  @media (min-width: 768px) {
    .hero-headline {
      font-size: 50px;
    }
  }

  @media (min-width: 1200px) {
    .hero-headline {
      font-size: 56px;
    }
  }

  .hero-headline-line {
    color: var(--color-text-white);
    font-weight: 500;
  }

  .accent-line {
    font-weight: 600;
    color: #ffffff;
    background: linear-gradient(135deg, #ffffff 30%, #79e2ec 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-narrative {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-cool-light);
    margin: 0;
    max-width: 480px;
  }

  @media (min-width: 768px) {
    .hero-narrative {
      font-size: 17px;
    }
  }

  .hero-action-row {
    display: flex;
    align-items: center;
    gap: var(--space-300);
    margin-top: var(--space-100);
  }

  .hero-primary-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--action-primary);
    color: #ffffff;
    padding: 0 24px;
    height: 42px;
    border-radius: var(--radius-full);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(36, 99, 235, 0.4);
    transition: all var(--duration-color) var(--ease-base);
  }

  .hero-primary-action:hover {
    background: var(--action-primary-hover);
    box-shadow: 0 6px 24px rgba(36, 99, 235, 0.55);
    transform: translateY(-1px);
  }

  .action-arrow {
    transition: transform var(--duration-color) var(--ease-base);
  }

  .hero-primary-action:hover .action-arrow {
    transform: translateX(3px);
  }

  .hero-secondary-link {
    font-size: 14px;
    color: var(--color-text-cool-muted);
    text-decoration: none;
    transition: color var(--duration-color) var(--ease-base);
  }

  .hero-secondary-link:hover {
    color: var(--text-primary);
  }

  /* Integrated Brand Logo Stage */
  .hero-visual-stage {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .hero-brand-logo-img {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 580px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 20px 40px rgba(2, 10, 18, 0.75));
    transition: transform var(--duration-layout) var(--ease-base);
  }

  .hero-visual-stage:hover .hero-brand-logo-img {
    transform: scale(1.02);
  }

  /* ==========================================================================
     2. Streamlined Journey Planning Panel
     ========================================================================== */
  .planner-section {
    position: relative;
    padding: var(--space-200) 0 var(--space-600);
  }

  .planner-container {
    max-width: 1040px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .planner-bar {
    background: rgba(11, 29, 43, 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(120, 210, 230, 0.12);
    border-radius: var(--radius-16);
    padding: 8px 12px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    box-shadow: 0 12px 36px rgba(2, 10, 18, 0.6);
  }

  @media (min-width: 640px) {
    .planner-bar {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .planner-bar {
      grid-template-columns: 1.3fr auto 1.35fr auto 1.35fr auto;
      align-items: center;
      gap: 0;
      padding: 6px 8px 6px 18px;
    }
  }

  .planner-segment {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 6px 10px;
  }

  .segment-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-cool-muted);
  }

  .field-icon {
    color: var(--color-cyan-bright);
    flex-shrink: 0;
  }

  .segment-select {
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 500;
    padding: 4px 0;
    outline: none;
    cursor: pointer;
    width: 100%;
  }

  .segment-select option {
    background: #0b1d2b;
    color: #f4f7fa;
  }

  .datetime-cluster {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .segment-input-date,
  .segment-input-time {
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 500;
    padding: 4px 0;
    outline: none;
  }

  .segment-input-date {
    flex: 1.2;
  }

  .segment-input-time {
    flex: 0.8;
  }

  .planner-divider {
    display: none;
  }

  @media (min-width: 1024px) {
    .planner-divider {
      display: block;
      width: 1px;
      height: 32px;
      background: rgba(255, 255, 255, 0.08);
      margin: 0 10px;
    }
  }

  .planner-action-segment {
    display: flex;
    align-items: center;
    padding: 4px;
  }

  .planner-submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--action-primary);
    color: #ffffff;
    border: none;
    border-radius: var(--radius-12);
    padding: 0 20px;
    height: 42px;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    width: 100%;
    white-space: nowrap;
    box-shadow: 0 2px 12px rgba(36, 99, 235, 0.4);
    transition: all var(--duration-color) var(--ease-base);
  }

  .planner-submit-btn:hover {
    background: var(--action-primary-hover);
    box-shadow: 0 4px 18px rgba(36, 99, 235, 0.55);
  }

  .planner-duration-hint {
    font-size: 12px;
    color: var(--color-text-cool-muted);
    padding: 0 6px;
    min-height: 18px;
  }

  /* ==========================================================================
     Shared Editorial Section Standards
     ========================================================================== */
  .editorial-section {
    padding: var(--space-800) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .editorial-eyebrow {
    font-size: 11px;
