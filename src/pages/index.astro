<script>
  import { getTodayKolkata, calculateRentalPeriods } from '../scripts/billing';
  import { getTripState, saveTripState } from '../scripts/trip';

  function initHeroSearch() {
    const pickupDateInput = document.getElementById('pickupDate') as HTMLInputElement;
    const returnDateInput = document.getElementById('returnDate') as HTMLInputElement;
    const pickupTimeInput = document.getElementById('pickupTime') as HTMLInputElement;
    const returnTimeInput = document.getElementById('returnTime') as HTMLInputElement;
    const durationIndicator = document.getElementById('heroDurationIndicator');
    const form = document.getElementById('heroSearchForm') as HTMLFormElement;

    if (!pickupDateInput || !returnDateInput) return;

    const today = getTodayKolkata();
    pickupDateInput.min = today;
    returnDateInput.min = today;

    const state = getTripState();
    if (state.pickupDate) pickupDateInput.value = state.pickupDate;
    else {
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      pickupDateInput.value = tomorrow.toISOString().split('T')[0];
    }

    if (state.returnDate) returnDateInput.value = state.returnDate;
    else {
      const dayAfter = new Date();
      dayAfter.setDate(dayAfter.getDate() + 3);
      returnDateInput.value = dayAfter.toISOString().split('T')[0];
    }

    if (state.pickupTime) pickupTimeInput.value = state.pickupTime;
    if (state.returnTime) returnTimeInput.value = state.returnTime;

    returnDateInput.min = pickupDateInput.value || today;

    function updateDuration() {
      if (!durationIndicator) return;
      const pDate = pickupDateInput.value;
      const rDate = returnDateInput.value;
      const pTime = pickupTimeInput.value || '10:00';
      const rTime = returnTimeInput.value || '10:00';

      if (!pDate || !rDate) {
        durationIndicator.textContent = '';
        return;
      }

      const res = calculateRentalPeriods(pDate, rDate, pTime, rTime);
      if (res.valid) {
        const periodWord = res.periods === 1 ? 'period' : 'periods';
        const hoursApprox = res.periods * 24;
        durationIndicator.innerHTML = `Rental schedule: ${res.periods} ${periodWord} (${hoursApprox} hours) &bull; Asia/Kolkata 24-hour billing cycle`;
      } else {
        durationIndicator.textContent = res.error || 'Return must be scheduled after pickup.';
      }
    }

    pickupDateInput.addEventListener('change', () => {
      if (pickupDateInput.value) {
        returnDateInput.min = pickupDateInput.value;
        if (returnDateInput.value && returnDateInput.value < pickupDateInput.value) {
          returnDateInput.value = pickupDateInput.value;
        }
      }
      updateDuration();
    });

    returnDateInput.addEventListener('change', updateDuration);
    pickupTimeInput.addEventListener('change', updateDuration);
    returnTimeInput.addEventListener('change', updateDuration);

    updateDuration();

    if (form) {
      form.addEventListener('submit', () => {
        const currentState = getTripState();
        if (pickupDateInput.value) currentState.pickupDate = pickupDateInput.value;
        if (returnDateInput.value) currentState.returnDate = returnDateInput.value;
        if (pickupTimeInput.value) currentState.pickupTime = pickupTimeInput.value;
        if (returnTimeInput.value) currentState.returnTime = returnTimeInput.value;
        saveTripState(currentState);
      });
    }
  }

  window.addEventListener('DOMContentLoaded', initHeroSearch);
</script>
