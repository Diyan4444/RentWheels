---
import BaseLayout from '../layouts/BaseLayout.astro';
import VehicleCard from '../components/VehicleCard.astro';
import { vehicles } from '../data/vehicles';
import { formatINR } from '../scripts/pricing';

const featuredVehicles = vehicles.filter((v) => v.featured);
const flagshipVehicle = vehicles.find((v) => v.slug === 'ford-mustang-gt') || vehicles[0];

const categories = [
  { key: 'car', name: 'Cars', slug: 'cars', count: 3, startingRate: 3100, icon: '🚗', desc: 'Sedans, crossovers, and performance coupes' },
  { key: 'bike', name: 'Bikes', slug: 'bikes', count: 3, startingRate: 1300, icon: '🏍️', desc: 'Cruisers, adventure, and track bikes' },
  { key: 'scooter', name: 'Scooters', slug: 'scooters', count: 3, startingRate: 1300, icon: '🛵', desc: 'Classic and modern city commuters' },
  { key: 'bus', name: 'Buses', slug: 'buses', count: 3, startingRate: 16400, icon: '🚌', desc: 'Executive coaches and intercity transport' },
  { key: 'truck', name: 'Trucks', slug: 'trucks', count: 3, startingRate: 8700, icon: '🚚', desc: 'Heavy haulers and dual-motor electric pickups' },
];

const mumbaiHubs = [
  { value: 'mumbai-central', label: 'Mumbai Central (Railway Hub)' },
  { value: 'bandra-west', label: 'Bandra West (Linking Road / Station)' },
  { value: 'andheri-east', label: 'Andheri East (WEH Metro Hub)' },
  { value: 'bkc', label: 'Bandra Kurla Complex (BKC Financial District)' },
  { value: 'borivali-west', label: 'Borivali West (Link Road)' },
  { value: 'airport-t2', label: 'CSMI Airport T2 (International / Domestic)' },
];
---

<BaseLayout
  title="RentWheels — Cinematic Vehicle Rentals Across Mumbai | Cars, Bikes, Scooters, Buses, Trucks"
  description="Discover 15 verified vehicles across Mumbai with transparent 24-hour pricing. Rent cars, bikes, scooters, buses and trucks with one unified booking enquiry."
>
  <!-- ========================================================================
       1. Cinematic Hero Section
       ======================================================================== -->
  <section class="hero-section">
    <!-- Ambient Cyan Glow Background Elements -->
    <div class="ambient-glow ambient-glow-top" aria-hidden="true"></div>
    <div class="ambient-glow ambient-glow-car" aria-hidden="true"></div>

    <div class="container hero-container">
      <div class="hero-main-grid">
        <!-- Hero Left Column: Copy & Actions -->
        <div class="hero-copy-col">
          <div class="hero-badge">
            <span class="hero-badge-dot" aria-hidden="true"></span>
            <span class="hero-badge-text">YOUR NEXT JOURNEY STARTS HERE</span>
          </div>

          <h1 class="hero-title">
            Find the car that feels right for every journey.
          </h1>

          <p class="hero-subheading">
            From daily city commutes to coastal highway cruises and group travel across Mumbai, discover verified vehicles with transparent 24-hour pricing and consolidated booking enquiries.
          </p>

          <div class="hero-cta-group">
            <a href="/fleet" class="hero-btn-primary">
              <span>Explore the fleet</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="#how-it-works" class="hero-btn-secondary">
              <span>How it works</span>
            </a>
          </div>

          <!-- Proof Line / Highlights -->
          <div class="hero-highlights-row">
            <div class="highlight-item">
              <span class="highlight-val">15</span>
              <span class="highlight-lbl">Verified vehicles</span>
            </div>
            <div class="highlight-divider" aria-hidden="true"></div>
            <div class="highlight-item">
              <span class="highlight-val">24h</span>
              <span class="highlight-lbl">Period billing</span>
            </div>
            <div class="highlight-divider" aria-hidden="true"></div>
            <div class="highlight-item">
              <span class="highlight-val">₹0</span>
              <span class="highlight-lbl">Upfront payment</span>
            </div>
          </div>
        </div>

        <!-- Hero Right Column: Large Flagship Vehicle Visual -->
        <div class="hero-visual-col">
          <div class="hero-car-wrapper">
            <div class="hero-car-backdrop" aria-hidden="true"></div>
            <img
              src={`/${flagshipVehicle.images[0].file}`}
              alt={flagshipVehicle.images[0].alt}
              width="720"
              height="450"
              loading="eager"
              fetchpriority="high"
              class="hero-car-img"
            />
            <div class="hero-car-badge">
              <span class="badge-accent-dot" aria-hidden="true"></span>
              <div class="badge-text-group">
                <span class="badge-name">{flagshipVehicle.name}</span>
                <span class="badge-price">From {formatINR(flagshipVehicle.estimatedRatePer24h)} / 24h</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ====================================================================
           Compact Booking / Search Interface Strip
           ==================================================================== -->
      <div class="search-strip-panel">
        <form id="heroSearchForm" class="search-strip-form" action="/fleet" method="GET">
          <div class="strip-fields-grid">
            <!-- 1. Pickup Location -->
            <div class="strip-field">
              <label for="pickupLocation" class="strip-label">
                <span class="strip-label-icon">📍</span>
                <span>Pickup Location</span>
              </label>
              <select id="pickupLocation" name="location" class="strip-select">
                {mumbaiHubs.map((hub) => (
                  <option value={hub.value}>{hub.label}</option>
                ))}
              </select>
            </div>

            <!-- 2. Pickup Date -->
            <div class="strip-field">
              <label for="pickupDate" class="strip-label">
                <span class="strip-label-icon">📅</span>
                <span>Pickup Date</span>
              </label>
              <input type="date" id="pickupDate" name="from" class="strip-input" required />
            </div>

            <!-- 3. Pickup Time -->
            <div class="strip-field">
              <label for="pickupTime" class="strip-label">
                <span class="strip-label-icon">⏰</span>
                <span>Pickup Time</span>
              </label>
              <input type="time" id="pickupTime" name="pickupTime" value="10:00" class="strip-input" required />
            </div>

            <!-- 4. Return Date -->
            <div class="strip-field">
              <label for="returnDate" class="strip-label">
                <span class="strip-label-icon">📅</span>
                <span>Return Date</span>
              </label>
              <input type="date" id="returnDate" name="to" class="strip-input" required />
            </div>

            <!-- 5. Return Time -->
            <div class="strip-field">
              <label for="returnTime" class="strip-label">
                <span class="strip-label-icon">⏰</span>
                <span>Return Time</span>
              </label>
              <input type="time" id="returnTime" name="returnTime" value="10:00" class="strip-input" required />
            </div>

            <!-- 6. Submit Button -->
            <div class="strip-action-field">
              <button type="submit" class="strip-btn-submit" aria-label="Search vehicles">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <span>Search</span>
              </button>
            </div>
          </div>

          <!-- Dynamic 24-Hour Rental Calculation Live Indicator -->
          <div class="strip-duration-bar">
            <span class="duration-icon">⚡</span>
            <span id="heroDurationIndicator" class="duration-text">
              Select pickup and return times to calculate 24-hour billing periods
            </span>
            <span class="duration-policy-tag">24h ceiling rule</span>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       2. Browse by Type (Cinematic Cards)
       ======================================================================== -->
  <section class="section browse-section">
    <div class="container">
      <div class="section-heading-block">
        <span class="section-eyebrow">FLEET CATEGORIES</span>
        <h2 class="heading-2 section-title">Browse by vehicle type</h2>
        <p class="body-3 section-desc">
          Compare 5 distinct vehicle classes in Mumbai, each backed by verified manufacturer specifications.
        </p>
      </div>

      <div class="categories-grid">
        {categories.map((cat) => (
          <a href={`/fleet/${cat.slug}`} class="category-card">
            <div class="cat-card-header">
              <span class="cat-icon" aria-hidden="true">{cat.icon}</span>
              <span class="cat-count-badge caption-4">{cat.count} vehicles</span>
            </div>
            <h3 class="cat-name title-2">{cat.name}</h3>
            <p class="cat-desc caption-2">{cat.desc}</p>
            <div class="cat-footer">
              <span class="cat-rate caption-2">From <strong>{formatINR(cat.startingRate)}</strong> / 24h</span>
              <span class="cat-arrow" aria-hidden="true">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================
       3. Featured Vehicles
       ======================================================================== -->
  <section class="section featured-section">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="section-eyebrow">CURATED SELECTION</span>
          <h2 class="heading-2 section-title">Featured vehicles</h2>
          <p class="body-3 section-desc">
            Popular choices for daily commutes, weekend getaways, and special occasions.
          </p>
        </div>
        <a href="/fleet" class="see-all-btn">
          <span>See all 15 vehicles</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <div class="featured-grid">
        {featuredVehicles.map((v) => (
          <VehicleCard vehicle={v} />
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================
       4. Problem & Solution Section (Single Consolidated Request)
       ======================================================================== -->
  <section class="section problem-section">
    <div class="container">
      <div class="problem-card">
        <div class="problem-glow" aria-hidden="true"></div>
        <div class="problem-content">
          <span class="problem-badge">THE RENTWHEELS ADVANTAGE</span>
          <h2 class="heading-2 problem-title">
            Renting for a complex journey should never require five separate enquiries.
          </h2>
          <p class="body-3 problem-body">
            A family vacation, a corporate offsite, and event transport require very different vehicles. Traditional rental agencies force you to juggle multiple vendors, incompatible booking systems, and varying calendar-day definitions. RentWheels lists all five categories in one place, using identical 24-hour rental periods and a unified request form, so you describe your trip once.
          </p>
          <div class="problem-stats-row">
            <div class="problem-stat">
              <span class="stat-number">1</span>
              <span class="stat-label">Unified Enquiry Form</span>
            </div>
            <div class="problem-stat">
              <span class="stat-number">24h</span>
              <span class="stat-label">Period-Based Duration</span>
            </div>
            <div class="problem-stat">
              <span class="stat-number">100%</span>
              <span class="stat-label">Verified Primary Specs</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       5. How It Works
       ======================================================================== -->
  <section id="how-it-works" class="section how-it-works-section">
    <div class="container">
      <div class="section-heading-block">
        <span class="section-eyebrow">TRANSPARENT PROCESS</span>
        <h2 class="heading-2 section-title">How booking enquiries work</h2>
        <p class="body-3 section-desc">
          A genuine request workflow with zero fabricated charges or upfront payment traps.
        </p>
      </div>

      <div class="steps-grid">
        <div class="step-box">
          <div class="step-header">
            <span class="step-num">01</span>
            <span class="step-tag">DISCOVER</span>
          </div>
          <h3 class="title-2 step-title">Choose dates and vehicles</h3>
          <p class="body-6 step-text">
            Select your pickup and return schedule in Mumbai. Every vehicle dynamically calculates its indicative price based on consecutive 24-hour billing cycles.
          </p>
        </div>

        <div class="step-box">
          <div class="step-header">
            <span class="step-num">02</span>
            <span class="step-tag">CONSOLIDATE</span>
          </div>
          <h3 class="title-2 step-title">Add what you need to your trip</h3>
          <p class="body-6 step-text">
            Combine cars, bikes, scooters, buses, or trucks into a single consolidated request. Review vehicle capabilities, seating, and estimated costs together.
          </p>
        </div>

        <div class="step-box">
          <div class="step-header">
            <span class="step-num">03</span>
            <span class="step-tag">CONFIRM</span>
          </div>
          <h3 class="title-2 step-title">Send one booking enquiry</h3>
          <p class="body-6 step-text">
            Submit your enquiry via Netlify Forms without paying upfront. Our Mumbai team verifies fleet availability and provides a definitive quote.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       6. FAQ Preview
       ======================================================================== -->
  <section class="section faq-preview-section">
    <div class="container faq-container">
      <div class="section-heading-block">
        <span class="section-eyebrow">COMMON INQUIRIES</span>
        <h2 class="heading-2 section-title">Frequently asked questions</h2>
        <p class="body-3 section-desc">
          Answers to questions before you submit your booking enquiry.
        </p>
      </div>

      <div class="faq-list">
        <details class="faq-card">
          <summary class="faq-summary title-3">
            <span>How does a booking request work?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-content body-3">
            Choose your dates and vehicles, add them to your trip staging, and submit the enquiry form. RentWheels receives your request through Netlify Forms and contacts you to confirm availability and final terms. No online payments are taken on this website.
          </div>
        </details>

        <details class="faq-card">
          <summary class="faq-summary title-3">
            <span>How are the 24-hour rental periods billed?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-content body-3">
            Rental duration is calculated strictly on consecutive 24-hour cycles starting from your selected pickup time (Asia/Kolkata timezone). Any additional commenced period is rounded up to the next full 24-hour period (ceiling rule). Calendar-day billing is not used.
          </div>
        </details>

        <details class="faq-card">
          <summary class="faq-summary title-3">
            <span>Can I rent more than one vehicle in one request?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-content body-3">
            Yes. You can add up to 5 vehicles across any categories (e.g. 2 cars and 1 bus) to your trip and submit a single consolidated enquiry for all of them.
          </div>
        </details>
      </div>

      <div class="faq-footer-cta">
        <a href="/faq" class="see-all-btn">
          <span>Read all frequently asked questions</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==========================================================================
     Hero Section — Midnight Electric Layout
     ========================================================================== */
  .hero-section {
    position: relative;
    padding: var(--space-600) 0 var(--space-800);
    overflow: hidden;
    background: radial-gradient(circle at 80% 20%, rgba(6, 59, 80, 0.35) 0%, rgba(7, 21, 34, 0) 65%),
                radial-gradient(circle at 20% 80%, rgba(7, 83, 106, 0.2) 0%, rgba(7, 21, 34, 0) 50%);
  }

  /* Ambient Glow Overlays */
  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .ambient-glow-top {
    top: -100px;
    right: 15%;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(18, 184, 208, 0.18) 0%, rgba(7, 83, 106, 0.05) 70%, transparent 100%);
  }

  .ambient-glow-car {
    top: 15%;
    right: 5%;
    width: 550px;
    height: 380px;
    background: radial-gradient(ellipse, rgba(25, 198, 217, 0.16) 0%, rgba(6, 59, 80, 0.12) 55%, transparent 80%);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-600);
  }

  .hero-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-500);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-main-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-600);
    }
  }

  /* Hero Copy */
  .hero-copy-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-300);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(7, 83, 106, 0.35);
    border: 1px solid rgba(18, 184, 208, 0.35);
    border-radius: var(--radius-full);
    padding: 6px 14px;
    width: fit-content;
    box-shadow: 0 0 16px rgba(18, 184, 208, 0.12);
  }

  .hero-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-cyan-bright);
    box-shadow: 0 0 8px var(--color-cyan-bright);
  }

  .hero-badge-text {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-cyan-bright);
    text-transform: uppercase;
  }

  .hero-title {
    font-family: var(--font-sans);
    font-size: 38px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text-white);
    margin: 0;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 48px;
    }
  }

  @media (min-width: 1200px) {
    .hero-title {
      font-size: 54px;
    }
  }

  .hero-subheading {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-cool-light);
    max-width: 600px;
    margin: 0;
  }

  @media (min-width: 768px) {
    .hero-subheading {
      font-size: 17px;
    }
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-200);
    margin-top: var(--space-100);
  }

  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--action-primary);
    color: #ffffff;
    padding: 14px 28px;
    border-radius: var(--radius-full);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--glow-blue-cta);
    transition: all var(--duration-color) var(--ease-base);
  }

  .hero-btn-primary:hover {
    background: var(--action-primary-hover);
    box-shadow: 0 6px 24px rgba(36, 99, 235, 0.6);
    transform: translateY(-2px);
  }

  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    background: rgba(16, 42, 61, 0.7);
    color: var(--text-primary);
    border: 1px solid var(--border-glass);
    padding: 14px 26px;
    border-radius: var(--radius-full);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    backdrop-filter: blur(12px);
    transition: all var(--duration-color) var(--ease-base);
  }

  .hero-btn-secondary:hover {
    background: rgba(7, 83, 106, 0.5);
    border-color: var(--color-cyan-bright);
    color: #ffffff;
  }

  /* Highlights Row */
  .hero-highlights-row {
    display: flex;
    align-items: center;
    gap: var(--space-300);
    padding-top: var(--space-200);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .highlight-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .highlight-val {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-cyan-bright);
    font-family: var(--font-sans);
  }

  .highlight-lbl {
    font-size: 12px;
    color: var(--color-text-cool-muted);
  }

  .highlight-divider {
    width: 1px;
    height: 28px;
    background: rgba(255, 255, 255, 0.12);
  }

  /* Hero Visual Column */
  .hero-visual-col {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-car-wrapper {
    position: relative;
    width: 100%;
    max-width: 650px;
  }

  .hero-car-backdrop {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 110%;
    height: 110%;
    background: radial-gradient(ellipse at center, rgba(18, 184, 208, 0.22) 0%, rgba(7, 83, 106, 0.12) 48%, transparent 72%);
    filter: blur(30px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-car-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.7));
    transition: transform var(--duration-layout) var(--ease-base);
  }

  .hero-car-wrapper:hover .hero-car-img {
    transform: scale(1.02);
  }

  .hero-car-badge {
    position: absolute;
    bottom: -10px;
    right: 20px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(4, 25, 39, 0.85);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(120, 210, 230, 0.25);
    border-radius: var(--radius-full);
    padding: 8px 16px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5), 0 0 16px rgba(18, 184, 208, 0.15);
  }

  .badge-accent-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-cyan-bright);
    box-shadow: 0 0 8px var(--color-cyan-bright);
  }

  .badge-text-group {
    display: flex;
    flex-direction: column;
  }

  .badge-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .badge-price {
    font-size: 11px;
    color: var(--color-cyan-ambient);
  }

  /* ==========================================================================
     Compact Booking / Search Strip Panel
     ========================================================================== */
  .search-strip-panel {
    background: var(--surface-glass-panel);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-24);
    padding: var(--space-200) var(--space-300);
    box-shadow: 0 16px 48px rgba(4, 21, 34, 0.75), 0 0 30px rgba(18, 184, 208, 0.1);
    margin-top: var(--space-200);
  }

