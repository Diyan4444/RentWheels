---
import BaseLayout from '../layouts/BaseLayout.astro';
import { vehicles } from '../data/vehicles';
---

<BaseLayout
  title="About RentWheels | Transparent Vehicle Rentals in Mumbai"
  description="Learn about RentWheels: vehicle rentals covering cars, bikes, scooters, buses and trucks across the Mumbai Metropolitan Region."
>
  <div class="container about-page-container">
    <div class="about-hero">
      <h1 class="heading-2">About RentWheels</h1>
      <p class="body-3 intro-lead">
        RentWheels brings multiple vehicle categories together into a single, straightforward booking enquiry experience across the Mumbai Metropolitan Region.
      </p>
    </div>

    <section class="about-section">
      <h2 class="title-1">What RentWheels Is</h2>
      <p class="body-3 section-body">
        Rather than navigating separate websites for two-wheelers, executive sedans, group coaches, and utility haulage, RentWheels provides an integrated platform covering five distinct vehicle types. Customers set their dates once, review indicative 24-hour rate estimates based on verified Mumbai market research, and submit a single consolidated enquiry.
      </p>
    </section>

    <section class="about-section">
      <h2 class="title-1">How Booking Enquiries Work</h2>
      <p class="body-3 section-body">
        RentWheels operates on a direct booking request model. When you send an enquiry:
      </p>
      <ol class="numbered-list body-3" role="list">
        <li>Your requested vehicles, duration, and pickup location are forwarded to our operations team.</li>
        <li>We check availability, document compliance (driving licenses), and scheduling.</li>
        <li>Our team contacts you directly to provide a confirmed reservation and final quotation.</li>
      </ol>
      <p class="body-3 section-body">
        No payment is charged on this website, and no reservation is confirmed until approved by an operator.
      </p>
    </section>

    <section class="about-section">
      <h2 class="title-1">Our Fleet by Category</h2>
      <div class="fleet-summary-table-wrapper">
        <table class="fleet-summary-table">
          <thead>
            <tr>
              <th class="caption-1">Category</th>
              <th class="caption-1">Vehicles Listed</th>
              <th class="caption-1">Seat Capacities</th>
              <th class="caption-1">Indicative Rates</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="body-5">Bikes</td>
              <td class="caption-1">Royal Enfield Classic 350, KTM 390 Duke, BMW R 1250 GS</td>
              <td class="caption-1">2 Seats</td>
              <td class="caption-1">From ₹1,300 / 24h</td>
            </tr>
            <tr>
              <td class="body-5">Cars</td>
              <td class="caption-1">Honda Civic, Toyota RAV4 Hybrid, Ford Mustang GT</td>
              <td class="caption-1">4 to 5 Seats</td>
              <td class="caption-1">From ₹3,100 / 24h</td>
            </tr>
            <tr>
              <td class="body-5">Scooters</td>
              <td class="caption-1">Vespa GTS 300 HPE, Yamaha TMAX Tech MAX, Honda ADV350</td>
              <td class="caption-1">2 Seats</td>
              <td class="caption-1">From ₹1,300 / 24h</td>
            </tr>
            <tr>
              <td class="body-5">Buses</td>
              <td class="caption-1">Volvo B8RLE, Mercedes-Benz Tourismo M/2, Thomas Built Saf-T-Liner C2</td>
              <td class="caption-1">45 to 72 Seats</td>
              <td class="caption-1">From ₹16,400 / 24h</td>
            </tr>
            <tr>
              <td class="body-5">Trucks</td>
              <td class="caption-1">Ford F-150, Kenworth T680, Rivian R1T (Electric)</td>
              <td class="caption-1">3 to 5 Seats</td>
              <td class="caption-1">From ₹8,700 / 24h</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page-container {
    padding-top: var(--space-600);
    padding-bottom: var(--space-900);
    max-width: 800px;
  }

  .about-hero {
    margin-bottom: var(--space-600);
  }

  .intro-lead {
    color: var(--text-secondary);
    margin-top: var(--space-100);
  }

  .about-section {
    margin-bottom: var(--space-600);
  }

  .about-section h2 {
    color: var(--text-primary);
    margin-bottom: var(--space-150, 12px);
  }

  .section-body {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-200);
  }

  .numbered-list {
    color: var(--text-secondary);
    padding-left: var(--space-400);
    display: flex;
    flex-direction: column;
    gap: var(--space-100);
    margin-bottom: var(--space-200);
  }

  .fleet-summary-table-wrapper {
    background-color: var(--surface-primary-subtle);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-12);
    overflow-x: auto;
    margin-top: var(--space-200);
  }

  .fleet-summary-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .fleet-summary-table th,
  .fleet-summary-table td {
    padding: var(--space-150, 12px) var(--space-200);
    border-bottom: 1px solid var(--border-primary);
  }

  .fleet-summary-table tr:last-child td {
    border-bottom: none;
  }

  .fleet-summary-table th {
    background-color: var(--surface-secondary);
    color: var(--text-primary);
  }

  .fleet-summary-table td {
    color: var(--text-secondary);
  }
</style>
